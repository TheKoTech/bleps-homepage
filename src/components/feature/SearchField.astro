---
import Search from '../../assets/Search.svg'
import PxIconButton from '../px/PxIconButton.astro'
import PxInput from '../px/PxInput.astro'
---

<form
	class="search-form"
	role="search"
	action="https://search.bleps.xyz/search"
	method="get"
>
	<PxInput
		type="search"
		name="q"
		placeholder="Query"
		aria-label="Search"
		autocomplete="off"
		autofocus
	>
		<PxIconButton slot="end" type="submit" icon={Search} label="Search" />
	</PxInput>
</form>

<style is:global>
	.search-form {
		display: flex;
		flex-direction: column;
		gap: calc(var(--l) * 4);
		inline-size: 100%;
	}
</style>
