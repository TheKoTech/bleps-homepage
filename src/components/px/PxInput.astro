---
import type { HTMLAttributes } from 'astro/types'
import PxRect from './PxRect.astro'

type Props = HTMLAttributes<'input'>

const inputAttrs = Astro.props
---

<PxRect class="px-input" corner="Corner2">
	<div class="px-input__inner">
		<input class="px-input__field" {...inputAttrs} />

		<slot name="end" />
	</div>
</PxRect>

<style is:global>
	.px-input {
		block-size: calc(var(--l) * 24);
		inline-size: 100%;
	}

	.px-input__inner {
		display: flex;
		inline-size: 100%;
		block-size: 100%;
		align-items: center;
		gap: calc(var(--l) * 8);
		justify-content: space-between;
		padding-inline: calc(var(--l) * 12);
	}

	.px-input__field {
		color: var(--primary);
		caret-color: var(--primary);
		padding-block-end: var(--l);
		inline-size: 100%;

		&:focus-visible {
			outline: unset;
		}

		/* Native clear button clashes with the pixel frame; Esc still clears */
		&::-webkit-search-cancel-button {
			appearance: none;
		}
	}
</style>
