---
import type { HTMLAttributes } from 'astro/types'

// Only Corner3 has a bevel frame
// span is for phrasing-only parents, e.g. inside a button
type Props = HTMLAttributes<'div'> & { as?: 'div' | 'span' } & (
		| { corner: 'Corner2'; bevel?: false }
		| { corner: 'Corner3'; bevel?: boolean }
	)

const {
	as: Tag = 'div',
	corner,
	bevel = false,
	class: className,
	...rest
} = Astro.props
---

<Tag
	class:list={[
		'px-rect',
		`px-rect--${corner.toLowerCase()}`,
		bevel && 'px-rect--bevel',
		className,
	]}
	{...rest}
>
	<slot />
</Tag>

<style is:global>
	/* Frames are 9-slice SVGs drawn with border-image on pseudo-elements.
	   border-image can't use currentColor, so the SVGs bake in --primary. */
	.px-rect {
		position: relative;

		--edge-pad: calc(var(--l) * var(--corner-size));

		&::before,
		&.px-rect--bevel::after {
			content: '';
			position: absolute;
			inset: 0;
			pointer-events: none;
			border-style: solid;
			border-width: var(--edge-pad);
			border-image-slice: var(--corner-size);
		}

		/* Bevel sits under the frame, shifted down-right */
		&.px-rect--bevel::after {
			inset: calc(var(--l) * 2) calc(var(--l) * -2) calc(var(--l) * -2)
				calc(var(--l) * 2);
		}
	}

	.px-rect--corner2 {
		--corner-size: 5;

		&::before {
			border-image-source: url('../../assets/Frame2.svg');
		}
	}

	.px-rect--corner3 {
		--corner-size: 2;

		&::before {
			border-image-source: url('../../assets/Frame3.svg');
		}

		&::after {
			border-image-source: url('../../assets/Frame3Bevel.svg');
		}
	}
</style>
