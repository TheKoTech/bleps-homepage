---
import '../styles/style.css'
import Adguard from '../assets/Adguard.svg'
import Frigate from '../assets/Frigate.svg'
import Homeassistant from '../assets/Homeassistant.svg'
import Seafile from '../assets/Seafile.svg'
import Searxng from '../assets/Searxng.svg'
import SearchField from '../components/feature/SearchField.astro'
import ServiceItem from '../components/feature/ServiceItem.astro'

const services = [
	{
		name: 'Seafile',
		icon: Seafile,
		hotkey: 'Ctrl+F',
		href: 'https://files.bleps.xyz',
	},
	{
		name: 'Searxng',
		icon: Searxng,
		hotkey: 'Ctrl+S',
		href: 'https://search.bleps.xyz',
	},
	{
		name: 'Adguard',
		icon: Adguard,
		hotkey: 'Ctrl+D',
		href: 'https://adguard.bleps.xyz',
	},
	{
		name: 'Homeassistant',
		icon: Homeassistant,
		hotkey: 'Ctrl+E',
		href: 'https://home.bleps.xyz',
	},
	{
		name: 'Frigate',
		icon: Frigate,
		hotkey: 'Ctrl+G',
		href: 'https://cam.bleps.xyz',
	},
]
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link
			rel="preload"
			href="/fonts/DepartureMono/DepartureMono-Regular.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>he blep</title>
	</head>
	<body>
		<main class="app-content">
			<h1 class="app-content__title">https://search.bleps.xyz/search?q=</h1>

			<h1 class="app-content__title app-content__title--small">
				search.bleps.xyz/search?q=
			</h1>

			<SearchField />

			<div class="app-content__services">
				{services.map((service) => (
					<ServiceItem {...service} />
				))}
			</div>
		</main>

		<script>
			// Hotkeys are read from the rendered service links, e.g. data-hotkey="Ctrl+F"
			const hotkeys = new Map(
				Array.from(
					document.querySelectorAll<HTMLAnchorElement>('a[data-hotkey]'),
					(link) => [link.dataset.hotkey!.toLowerCase(), link.href],
				),
			)

			window.addEventListener('keydown', (event) => {
				const key = [
					event.ctrlKey && 'ctrl',
					event.shiftKey && 'shift',
					event.altKey && 'alt',
					event.metaKey && 'meta',
					event.code.replace(/^Key(?=[A-Z])/, '').toLowerCase(),
				]
					.filter(Boolean)
					.join('+')

				const href = hotkeys.get(key)
				if (!href) return

				event.preventDefault()
				window.location.href = href
			})
		</script>
	</body>
</html>

<style is:global>
	.app-content {
		block-size: 100%;
		inline-size: 100%;
		margin-inline: auto;
		max-inline-size: calc(var(--l) * 380);
		padding-inline: calc(var(--l) * 16);
		align-items: flex-start;
		justify-content: center;

		display: flex;
		flex-direction: column;
		gap: calc(var(--l) * 12);
	}

	.app-content__title {
		font-size: 1rem;
	}

	.app-content__title--small {
		display: none;
	}

	.app-content__services {
		display: flex;
		align-items: center;
		inline-size: 100%;
		justify-content: center;
		gap: calc(var(--l) * 6);
	}

	@media screen and (width <= 700px) {
		.app-content__services {
			flex-wrap: wrap;
		}
	}

	@media screen and (width <= 450px) {
		.app-content {
			padding-inline: calc(var(--l) * 8);
		}
	}

	@media screen and (width < 392px) {
		.app-content__title {
			display: none;
		}

		.app-content__title--small {
			display: block;
		}
	}
</style>
