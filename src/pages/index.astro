---
import '../styles/style.css'
import Adguard from '../assets/Adguard.svg'
import Frigate from '../assets/Frigate.svg'
import Homeassistant from '../assets/Homeassistant.svg'
import Seafile from '../assets/Seafile.svg'
import Searxng from '../assets/Searxng.svg'
import AppFooter from '../components/feature/AppFooter.astro'
import SearchField from '../components/feature/SearchField.astro'
import ServiceItem from '../components/feature/ServiceItem.astro'

const services = [
	{
		name: 'Seafile',
		icon: Seafile,
		hotkey: 'Ctrl+F',
		href: 'https://files.bleps.xyz',
	},
	{
		name: 'Searxng',
		icon: Searxng,
		hotkey: 'Ctrl+S',
		href: 'https://search.bleps.xyz',
	},
	{
		name: 'Adguard',
		icon: Adguard,
		hotkey: 'Ctrl+D',
		href: 'https://adguard.bleps.xyz',
	},
	{
		name: 'Homeassistant',
		icon: Homeassistant,
		hotkey: 'Ctrl+E',
		href: 'https://home.bleps.xyz',
	},
	{
		name: 'Frigate',
		icon: Frigate,
		hotkey: 'Ctrl+G',
		href: 'https://cam.bleps.xyz',
	},
]
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link
			rel="preload"
			href="/fonts/DepartureMono/DepartureMono-Regular.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>blep!</title>
	</head>
	<body>
		<main class="app-content">
			<h1 class="app-content__title">
				blep! <span>:b</span>
			</h1>

			<SearchField />

			<div class="app-content__services">
				{services.map((service) => (
					<ServiceItem {...service} />
				))}
			</div>
		</main>

		<AppFooter />

		<script>
			const titles = [
				['blep!', ';b'],
				['blep!', ':3'],
				['blep?', ':b'],
				['blep.', ':b'],
				['blep.', ';b'],
				['blep!', '>:b'],
				['b-blep?', '>w<'],
				['bwehh..', '-w-'],
				['bwah!', 'OwO'],
				['meow!', '^w^'],
				['No blep this time', ''],
			]

			if (Math.random() < 0.01) {
				const [text, face] = titles[Math.floor(Math.random() * titles.length)]
				const title = document.querySelector('.app-content__title')!
				title.firstChild!.textContent = `${text} `
				title.querySelector('span')!.textContent = face
			}

			// Hotkeys are read from the rendered service links, e.g. data-hotkey="Ctrl+F"
			const hotkeys = new Map(
				Array.from(
					document.querySelectorAll<HTMLAnchorElement>('a[data-hotkey]'),
					(link) => [link.dataset.hotkey!.toLowerCase(), link.href],
				),
			)

			window.addEventListener('keydown', (event) => {
				const key = [
					event.ctrlKey && 'ctrl',
					event.shiftKey && 'shift',
					event.altKey && 'alt',
					event.metaKey && 'meta',
					event.code.replace(/^Key(?=[A-Z])/, '').toLowerCase(),
				]
					.filter(Boolean)
					.join('+')

				const href = hotkeys.get(key)
				if (!href) return

				event.preventDefault()
				window.location.href = href
			})
		</script>
	</body>
</html>

<style is:global>
	body {
		display: flex;
		flex-direction: column;
	}

	/* Footer shares the content column so it lines up with the search field */
	.app-content,
	.app-footer {
		inline-size: 100%;
		margin-inline: auto;
		max-inline-size: calc(var(--l) * 382);
		padding-inline: calc(var(--l) * 16);
	}

	.app-content {
		flex: 1;
		align-items: flex-start;
		justify-content: center;
		padding-block: calc(var(--l) * 40);

		display: flex;
		flex-direction: column;
		gap: calc(var(--l) * 16);
	}

	.app-content__title {
		font-size: 2rem;

		& > * {
			letter-spacing: calc(var(--l) * -1);
		}
	}

	.app-content__services {
		display: flex;
		align-items: center;
		inline-size: 100%;
		justify-content: center;
		gap: calc(var(--l) * 4);
	}

	@media screen and (width < 764px) {
		.app-content {
			gap: calc(var(--l) * 10);
			padding-block: calc(var(--l) * 24);
		}

		.app-content__services {
			flex-wrap: wrap;
		}

		.app-content__title {
			font-size: 1.5rem;
		}
	}

	@media screen and (width <= 420px) {
		.app-content,
		.app-footer {
			padding-inline: calc(var(--l) * 12);
		}

		.app-content {
			padding-block: calc(var(--l) * 12);
		}
	}
</style>
